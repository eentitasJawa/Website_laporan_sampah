generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  nama          String
  email         String          @unique
  noHp          String          @unique
  password      String
  role          String          @default("USER")
  moneyPocket   Decimal         @default(0) @db.Decimal(14, 2)

  laporanSampah LaporanSampah[]
  transaksi     Transaksi[]
}

model JenisSampah {
  id            String          @id @default(uuid())
  namaJenis     String          @unique
  hargaPerKg    Decimal         @default(2000) @db.Decimal(12, 2)

  laporanSampah LaporanSampah[]
  transaksi     Transaksi[]
}

model Wilayah {
  id             String          @id @default(uuid())
  namaWilayah    String          @unique
  laporanSampah  LaporanSampah[]
}

model Tag {
  id             String          @id @default(uuid())
  namaTag        String          @unique
  laporanSampah  LaporanSampah[] @relation("LaporanToTag")
}

model LaporanSampah {
  id             String          @id @default(uuid())
  userId         String
  jenisSampahId  String
  wilayahId      String
  deskripsi      String
  status         String          @default("PENDING") // PENDING, PROSES, SELESAI
  createdAt      DateTime        @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisSampah    JenisSampah     @relation(fields: [jenisSampahId], references: [id], onDelete: Restrict)
  wilayah        Wilayah         @relation(fields: [wilayahId], references: [id], onDelete: Restrict)
  fotoSampah     FotoSampah?
  tags           Tag[]           @relation("LaporanToTag")
}

model FotoSampah {
  id             String          @id @default(uuid())
  laporanId      String          @unique
  url            String

  laporanSampah  LaporanSampah   @relation(fields: [laporanId], references: [id], onDelete: Cascade)
}

enum StatusTransaksi {
  PENDING
  DIPROSES
  SELESAI
  DIBATALKAN
}

model Transaksi {
  id             String          @id @default(uuid())
  userId         String
  jenisId        String

  berat          Decimal         @db.Decimal(10, 2)
  hargaPerKg     Decimal         @db.Decimal(12, 2)
  totalHarga     Decimal         @db.Decimal(12, 2)

  status         StatusTransaksi @default(PENDING)
  saldoDiberikan Boolean         @default(false)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  jenis          JenisSampah     @relation(fields: [jenisId], references: [id])

  @@index([userId])
  @@index([jenisId])
  @@index([status])
}